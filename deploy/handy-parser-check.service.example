[Unit]
Description=Handy Parser scheduled check in Docker
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/handy-parser
ExecStart=/usr/bin/docker compose --env-file .env -f compose.yaml run --rm -T --name handy-parser-check check
# Stop the known one-off container even if the compose client is interrupted.
ExecStopPost=-/usr/bin/docker stop --time 15 handy-parser-check
TimeoutStartSec=5min
TimeoutStopSec=30s
